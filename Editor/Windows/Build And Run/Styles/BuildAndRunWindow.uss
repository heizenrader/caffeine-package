/* Build & Run Window.
   Loaded after CrossPlatformPublish.uss, whose tokens (.cpp-root) and
   stepper / stat tile / log card classes this window reuses so it reads like
   the Publishing page. Only the window layout and overrides live here. */

.br-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--cpp-bg);
    padding: 14px 16px 16px 16px;
}

/* ---------- Segmented Mode Switch (2D / VR) ---------- */

.br-root .mode-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 18px;
}

.seg-btn {
    min-height: 30px;
    min-width: 88px;
    padding-left: 14px;
    padding-right: 14px;
    font-size: 14px;
    margin: 0;
    border-width: 1px;
    border-color: var(--cpp-border);
    background-color: var(--cpp-card);
    color: var(--cpp-text);
}

.seg-btn.left {
    border-radius: 8px 0 0 8px;
}

.seg-btn.right {
    border-radius: 0 8px 8px 0;
    margin-left: -1px; /* hide double seam */
}

.seg-btn:hover {
    background-color: var(--cpp-card-hover);
}

.seg-btn.is-selected {
    background-color: var(--cpp-accent-soft);
    border-color: var(--cpp-accent);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.seg-btn.is-selected:hover {
    background-color: var(--cpp-accent);
}

.seg-btn:disabled,
.seg-btn:disabled:hover {
    opacity: 0.6;
}

/* ---------- Progress ---------- */

.br-root .stepper {
    flex-shrink: 0;
    margin-bottom: 16px;
}

.br-root .br-bar {
    height: 10px;
    flex-shrink: 0;
    border-radius: 5px;
    margin-bottom: 14px;
}

.br-root .br-bar .bar-fill {
    border-radius: 5px;
}

.br-root .bar-fill.is-failed {
    background-color: var(--cpp-danger);
}

.br-root .stat-row {
    flex-shrink: 0;
    margin-bottom: 14px;
}

/* ---------- Logs: take whatever height is left ---------- */

/* The only element that gives up height when the window is made smaller —
   everything above it is flex-shrink: 0, so the run state can never be
   clipped away. Below its min-height the window itself stops resizing
   (minSize in BuildAndRunWindow.cs). */
.br-root .br-log-card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 150px;
    margin-bottom: 16px;
}

/* flex-basis: 0 is load-bearing. The publish panel gives these lists a fixed
   height; this window lets them fill instead, and with the default
   flex-basis: auto each list is first sized from its CONTENT. The Build Log
   (a handful of lines) then grew to fill, while the Unity Log (thousands of
   raw lines) claimed a base size far taller than the card and got squeezed
   back into a condensed strip. Sizing from zero makes both tabs fill the
   same box regardless of how much is in them. */
.br-root .log-list {
    height: auto;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 100px;
}

/* ---------- Buttons ---------- */

.br-footer {
    flex-direction: row;
    flex-shrink: 0;
}

.br-root .br-btn {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 34px;
    margin: 0 0 0 10px;
    font-size: 13px;
}

.br-root .br-btn--first {
    margin-left: 0;
    -unity-font-style: bold;
}

.br-root .cpp-btn--primary:hover:enabled {
    background-color: rgb(64, 142, 245);
}
