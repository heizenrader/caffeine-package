.customToggle Label {
    -unity-text-align: middle-left;
    width: auto;
    flex-shrink: 0;
    height: 10px;
    flex-grow: 1;
    position: absolute;
    white-space: nowrap;
    min-width: 0;
    min-height: 0;
    padding-left: 15px;
}

.customToggle VisualElement {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
}

.chip {
    background-color: rgb(88, 88, 88);
    background-image: none;
    color: rgb(210, 210, 210);
    font-size: 12px;
    height: 24px;
    padding-left: 12px;
    padding-right: 12px;
    margin-left: 0;
    margin-right: 6px;
    margin-top: 0;
    margin-bottom: 0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.chip:hover {
    background-color: rgb(104, 104, 104);
}

.chip.selected {
    background-color: rgb(32, 135, 200);
    color: rgb(255, 255, 255);
}

/* ---- Search popup (viewer-style search sheet, editor port) ---- */

.search-popup {
    background-color: rgb(48, 48, 48);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(28, 28, 28);
    border-right-color: rgb(28, 28, 28);
    border-top-color: rgb(28, 28, 28);
    border-bottom-color: rgb(28, 28, 28);
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
    flex-direction: column;
}

.search-popup__chips {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    align-items: center;
    margin-bottom: 4px;
}

.search-popup__chip {
    margin-bottom: 4px;
}

.search-popup__chip-divider {
    width: 4px;
    height: 4px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    background-color: rgb(110, 110, 110);
    margin-left: 2px;
    margin-right: 8px;
    margin-bottom: 4px;
}

/* The list is a virtualized ListView. Its height is assigned from code (SearchPopup.UpdateListHeight)
   because a ListView needs a definite height to virtualize — content-sizing it would realize every row.
   flex-shrink + min-height: 0 are a safety valve so it can never push past the panel's max height. */
.search-popup__list {
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
}

.search-popup__empty {
    color: rgb(170, 170, 170);
    padding-top: 12px;
    padding-bottom: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.search-popup__footer {
    color: rgb(140, 140, 140);
    font-size: 10px;
    padding-top: 4px;
    padding-bottom: 2px;
    -unity-text-align: middle-center;
}

/* height MUST stay in sync with SearchPopup.RowHeight — FixedHeight virtualization positions rows from
   that constant, so a mismatch slides the scroll position out of step with what is drawn. */
.search-popup-row {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.search-popup-row:hover {
    background-color: rgb(66, 66, 66);
}

.search-popup-row.selected {
    background-color: rgb(38, 79, 120);
}

.search-popup-row__icon-col {
    width: 44px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.search-popup-row__folder-icon {
    width: 18px;
    height: 18px;
}

.search-popup-row__glyph {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-bottom: 0;
}

.search-popup-row__caption {
    font-size: 9px;
    color: rgb(150, 150, 150);
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-bottom: 0;
}

.search-popup-row__text-col {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    margin-left: 2px;
}

.search-popup-row__title {
    font-size: 13px;
    color: rgb(228, 228, 228);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-bottom: 0;
}

.search-popup-row__path {
    font-size: 11px;
    color: rgb(150, 150, 150);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-top: 0;
}

.search-popup-row__star {
    font-size: 16px;
    width: 26px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.search-popup-row__star:hover {
    font-size: 18px;
}
