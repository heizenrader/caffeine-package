<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:Template name="CloudBackup" src="CloudBackup.uxml" />
    <ui:Template name="CrossPlatformPublish" src="CrossPlatformPublish.uxml" />
    <ui:VisualElement name="Publishing" class="pub-section" style="flex-grow: 1;">
        <ui:VisualElement name="Body" class="pub-section__body" style="flex-grow: 1;">
            <ui:Instance template="CloudBackup" name="CloudBackupInstance" />
            <ui:VisualElement name="PackageSummary" class="pub-subpanel" style="display: none;">
                <ui:VisualElement class="pub-group-header">
                    <ui:Label text="Package Contents" class="pub-group__label" />
                    <ui:Label name="SummarySubtitle" text="" class="pub-panel__subtitle" />
                </ui:VisualElement>
                <ui:VisualElement name="SummaryRow" class="pub-summary-row">
                    <ui:VisualElement name="AssetsStat" class="pub-summary-stat">
                        <ui:Label name="AssetsValue" text="—" class="pub-summary-stat__value" />
                        <ui:Label text="Assets" class="pub-summary-stat__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ScriptsStat" class="pub-summary-stat">
                        <ui:Label name="ScriptsValue" text="—" class="pub-summary-stat__value" />
                        <ui:Label text="Scripts" class="pub-summary-stat__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SizeStat" class="pub-summary-stat">
                        <ui:Label name="SizeValue" text="—" class="pub-summary-stat__value" />
                        <ui:Label text="Package Size" class="pub-summary-stat__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="pub-summary-row__spacer" />
                    <ui:Button name="ViewContentsButton" text="View Package Contents" class="pub-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Instance template="CrossPlatformPublish" name="CrossPlatformPublishInstance" style="flex-grow: 1;" />
            <ui:VisualElement name="PublishingActionBar" class="pub-action-bar">
                <ui:VisualElement class="pub-action-bar__spacer" />
                <ui:Button name="PublishingResetButton" text="Close" class="pub-btn" />
                <ui:Button name="PublishingCancelButton" text="Cancel All" class="pub-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
