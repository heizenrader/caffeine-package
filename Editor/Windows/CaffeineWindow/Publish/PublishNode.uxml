<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:Template name="PublishNodeHeader" src="project://database/Packages/com.caffeine/Editor/Windows/CaffeineWindow/Publish/PublishNodeHeader.uxml?fileID=9197481963319205126&amp;guid=4570288ca5550a04bb1e7ed77a95b1aa&amp;type=3#PublishNodeHeader" />
    <ui:Template name="PublishConfiguration" src="PublishConfiguration.uxml" />
    <ui:Template name="Publishing" src="Publishing.uxml" />
    <ui:ScrollView style="flex-grow: 1;">
        <ui:VisualElement name="PublishViewContent" style="flex-grow: 1; align-items: stretch; justify-content: flex-start;">
            <ui:Instance template="PublishNodeHeader" name="PublishHeader" style="-unity-font-style: bold; font-size: 14px;" />
            <ui:VisualElement name="ConfigurePage" style="flex-grow: 1; flex-shrink: 0;">
                <ui:Instance template="PublishConfiguration" name="PublishConfigurationInstance" />
            </ui:VisualElement>
            <ui:VisualElement name="PublishingPage" style="flex-grow: 1; flex-shrink: 0; display: none;">
                <ui:Instance template="Publishing" name="PublishingInstance" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
    <ui:VisualElement name="PublishStepFooter" class="pub-step-footer">
        <ui:VisualElement name="StepText" class="pub-step-footer__text">
            <ui:Label name="StepTitle" text="Step 1 of 3 — Course Validation" class="pub-step-footer__step" />
            <ui:VisualElement name="StepMessageRow" class="pub-step-footer__message-row">
                <ui:Label name="StepMessage" text="" class="pub-step-footer__message" />
                <ui:VisualElement name="StepMessageAction" class="pub-step-footer__action">
                    <ui:Label name="StepMessageLead" text="" class="pub-step-footer__message" />
                    <ui:Button name="StepMessageLink" text="Course Validator" tooltip="Open the Course Validator" class="pub-step-footer__link" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="pub-step-footer__spacer" />
        <ui:Button name="ValidateButton" text="Validate Course" class="pub-btn pub-btn--primary" />
        <ui:Button name="ProceedAnywayButton" text="Proceed Anyway" class="pub-btn" />
        <ui:Button name="StartPackagingButton" text="Start Packaging" class="pub-btn pub-btn--primary" />
        <ui:Button name="NextButton" text="Next" class="pub-btn pub-btn--primary" />
        <ui:Button name="StartButton" text="Start Publishing" class="pub-btn pub-btn--primary" />
        <ui:Button name="ResetButton" text="Reset" class="pub-btn" />
    </ui:VisualElement>
</ui:UXML>
